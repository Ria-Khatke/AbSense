@{

<h1> AbSense</h1>

    <h2>Login</h2>

    <title>AbSence – Specsavers Leave Portal</title>
  
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
 
    :root {
      --red: #D6001C;
      --red-dark: #A8001A;
      --red-light: #FFF0F2;
      --red-mid: #F5C0C7;
      --black: #111111;
      --offwhite: #F8F7F5;
      --white: #FFFFFF;
      --gray: #6B6B6B;
      --gray-light: #E8E6E2;
      --text: #1A1A1A;
      --radius: 14px;
      --radius-sm: 8px;
      --shadow: 0 8px 32px rgba(0,0,0,0.10);
      --shadow-lg: 0 20px 60px rgba(0,0,0,0.14);
    }
 
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--offwhite);
      min-height: 100vh;
      display: flex;
      overflow: hidden;
    }
 
    /* === SPLIT LAYOUT === */
    .left-panel {
      width: 45%;
      background: var(--red);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 48px;
      position: relative;
      overflow: hidden;
    }
 
    .left-panel::before {
      content: '';
      position: absolute;
      top: -120px; right: -120px;
      width: 500px; height: 500px;
      border-radius: 50%;
      background: rgba(255,255,255,0.05);
    }
    .left-panel::after {
      content: '';
      position: absolute;
      bottom: -80px; left: -80px;
      width: 340px; height: 340px;
      border-radius: 50%;
      background: rgba(0,0,0,0.08);
    }
 
    .brand {
      position: relative; z-index: 2;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }
    .brand-icon {
      width: 40px; height: 40px;
      background: rgba(255,255,255,0.2);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 20px;
    }
    .brand-name {
      font-family: 'DM Serif Display', serif;
      font-size: 26px;
      color: #fff;
      letter-spacing: -0.5px;
    }
    .brand-name span {
      font-style: italic;
    }
    .brand-sub {
      font-size: 13px;
      color: rgba(255,255,255,0.65);
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
 
    .left-copy {
      position: relative; z-index: 2;
    }
    .left-copy h1 {
      font-family: 'DM Serif Display', serif;
      font-size: 42px;
      line-height: 1.15;
      color: #fff;
      margin-bottom: 16px;
      letter-spacing: -0.5px;
    }
    .left-copy h1 em {
      font-style: italic;
      color: rgba(255,255,255,0.75);
    }
    .left-copy p {
      font-size: 15px;
      color: rgba(255,255,255,0.70);
      line-height: 1.65;
      max-width: 300px;
    }
 
    .left-badges {
      position: relative; z-index: 2;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .badge {
      background: rgba(255,255,255,0.15);
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 20px;
      padding: 6px 14px;
      font-size: 12px;
      color: rgba(255,255,255,0.90);
      letter-spacing: 0.2px;
    }
 
    /* === RIGHT PANEL === */
    .right-panel {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 48px;
      overflow-y: auto;
    }
 
    .card {
      background: var(--white);
      border-radius: var(--radius);
      box-shadow: var(--shadow-lg);
      padding: 48px 44px;
      width: 100%;
      max-width: 420px;
    }
 
    /* === TABS === */
    .tabs {
      display: flex;
      background: var(--offwhite);
      border-radius: var(--radius-sm);
      padding: 4px;
      margin-bottom: 36px;
      border: 1px solid var(--gray-light);
    }
    .tab-btn {
      flex: 1;
      padding: 10px;
      border: none;
      background: transparent;
      border-radius: 6px;
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      font-weight: 500;
      color: var(--gray);
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .tab-btn.active {
      background: var(--white);
      color: var(--red);
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    /* === FORM === */
    .form-title {
      font-family: 'DM Serif Display', serif;
      font-size: 26px;
      color: var(--text);
      margin-bottom: 6px;
      letter-spacing: -0.3px;
    }
    .form-subtitle {
      font-size: 14px;
      color: var(--gray);
      margin-bottom: 28px;
      line-height: 1.5;
    }
 
    .form-group {
      margin-bottom: 18px;
    }
    label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: var(--text);
      margin-bottom: 6px;
      letter-spacing: 0.1px;
    }
    input[type="text"],
    input[type="email"],
    input[type="password"],
    select {
      width: 100%;
      padding: 12px 16px;
      border: 1.5px solid var(--gray-light);
      border-radius: var(--radius-sm);
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      color: var(--text);
      background: var(--white);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      appearance: none;
    }
    input:focus, select:focus {
      border-color: var(--red);
      box-shadow: 0 0 0 3px rgba(214, 0, 28, 0.10);
    }
    input::placeholder { color: #BABABA; }
 
    .input-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
 
    .role-select-wrap {
      position: relative;
    }
    .role-select-wrap::after {
      content: '▾';
      position: absolute; right: 14px; top: 50%;
      transform: translateY(-50%);
      color: var(--gray);
      pointer-events: none;
      font-size: 12px;
    }
 
    .password-wrap {
      position: relative;
    }
    .password-wrap input { padding-right: 44px; }
    .toggle-pw {
      position: absolute; right: 12px; top: 50%;
      transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      color: var(--gray); font-size: 18px; padding: 4px;
      line-height: 1;
    }
    .toggle-pw:hover { color: var(--red); }
 
    .forgot-link {
      display: block;
      text-align: right;
      font-size: 12px;
      color: var(--red);
      text-decoration: none;
      margin-top: -10px;
      margin-bottom: 18px;
    }
    .forgot-link:hover { text-decoration: underline; }
 
    .terms {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 20px;
    }
    .terms input[type="checkbox"] {
      width: 16px; height: 16px;
      margin-top: 2px;
      accent-color: var(--red);
      flex-shrink: 0;
    }
    .terms span {
      font-size: 12.5px;
      color: var(--gray);
      line-height: 1.5;
    }
    .terms a { color: var(--red); text-decoration: none; }
    .terms a:hover { text-decoration: underline; }
 
    .btn-primary {
      width: 100%;
      padding: 14px;
      background: var(--red);
      color: #fff;
      border: none;
      border-radius: var(--radius-sm);
      font-family: 'DM Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      letter-spacing: 0.2px;
    }
    .btn-primary:hover { background: var(--red-dark); }
    .btn-primary:active { transform: scale(0.99); }
 
    .divider {
      display: flex; align-items: center; gap: 12px;
      margin: 22px 0; color: var(--gray); font-size: 12px;
    }
    .divider::before, .divider::after {
      content: ''; flex: 1;
      height: 1px; background: var(--gray-light);
    }
 
    .btn-sso {
      width: 100%;
      padding: 12px;
      background: var(--white);
      border: 1.5px solid var(--gray-light);
      border-radius: var(--radius-sm);
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      font-weight: 500;
      color: var(--text);
      cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 10px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .btn-sso:hover {
      border-color: var(--red-mid);
      box-shadow: 0 2px 8px rgba(214, 0, 28, 0.08);
    }
    .btn-sso img { width: 20px; height: 20px; }
 
    .secure-note {
      display: flex; align-items: center; justify-content: center;
      gap: 6px; margin-top: 22px;
      font-size: 11.5px; color: #ABABAB;
    }
    .secure-note svg { width: 12px; height: 12px; }
 
    /* === ALERT === */
    .alert {
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      font-size: 13px;
      margin-bottom: 18px;
      display: none;
    }
    .alert.error { background: #FFF0F2; color: #A8001A; border: 1px solid #F5C0C7; }
    .alert.success { background: #F0FBF4; color: #1A6B37; border: 1px solid #B4E4C7; }
    .alert.show { display: block; }
 
    /* === FOOTER === */
    .specsavers-footer {
      position: fixed; bottom: 0; left: 0; right: 0;
      background: var(--white);
      border-top: 1px solid var(--gray-light);
      padding: 10px 48px;
      display: flex; align-items: center; justify-content: space-between;
      font-size: 11px; color: var(--gray);
      z-index: 10;
    }
 
    /* === PANEL HIDING === */
    .panel { display: none; }
    .panel.active { display: block; }
 
    </style>
}

