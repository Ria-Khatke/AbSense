@{
    Layout = null;
}
<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<link rel="stylesheet" href="~/css/staff_dashboard_style.css" /> 

<div class="container">

    <div class =  " title">
        <h1>Hello,[name of the staff]</h1>
    </div>


    <div class="card_container">
        <div class = "box">
            <div class="title">
                <h2>Holiday balance</h2>
            </div>
            <div class="amount">
                11
            </div>
        </div>
        <div class="box">
            <div class="title">
                <h2>Holidays booked</h2>
            </div>
            <div class="amount">
                8
            </div>
        </div>
        <div class="box">
            <div class="title">
                <h2>Upcoming holidays</h2>
            </div>
            <div class="amount">
                2
            </div>
         </div>
    </div>
    <div class=" Book_leave">
        <h1>Book your leave</h1>
        <p>Fields with an asterisk (*) are required to fill before submitting the request</p>
        <form asp-action="Book_leave" asp-controller="Dashboard" method="post">
            <label for="Reason">Reason for Leave</label>
            <input type="text" name="Reason" value="" />

            <label for="StartDate">From * </label>
            <input type="date" name="StartDate" value="" required/>

            <label for="EndDate">To * </label>
            <input type="date" name="EndDate" value="" required />

            <label for="TotalDays">Total Days booked</label>
            <input type="number" name="TotalDays" value="" />

            <button class="submit_form">Submit request</button>
        </form>

    </div>


</div>
@* 
<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=DM+Serif+Display:ital@0;1&display=swap');

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --navy: #0F2B46;
        --teal: #1D7B6E;
        --teal-lt: #E4F4F1;
        --sky: #E8F3FA;
        --white: #FFFFFF;
        --muted: #6B7A8D;
        --border: #D4DCE6;
        --text: #1A2733;
        --radius: 12px;
        --shadow: 0 4px 24px rgba(15, 43, 70, 0.09);
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background-color: var(--sky);
        background-image: radial-gradient(ellipse 80% 40% at 10% 0%, rgba(29, 123, 110, 0.07) 0%, transparent 60%), radial-gradient(ellipse 60% 40% at 90% 100%, rgba(15, 43, 70, 0.07) 0%, transparent 60%);
        min-height: 100vh;
        color: var(--text);
        padding: 40px 24px;
    }

    /* ── Page container ── */
    .container {
        max-width: 900px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    /* ── Greeting ── */
    .title h1 {
        font-family: 'DM Serif Display', serif;
        font-size: 2rem;
        font-weight: 400;
        color: var(--navy);
        letter-spacing: -0.4px;
    }

        .title h1::after {
            content: '';
            display: block;
            width: 48px;
            height: 3px;
            background: var(--teal);
            border-radius: 2px;
            margin-top: 10px;
        }

    /* ── Stat cards row ── */
    .card_container {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .box {
        background: var(--white);
        border-radius: var(--radius);
        padding: 28px 24px;
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 16px;
        position: relative;
        overflow: hidden;
        transition: transform 0.18s, box-shadow 0.18s;
    }

        .box:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 28px rgba(15, 43, 70, 0.13);
        }

        /* coloured top accent per card */
        .box:nth-child(1)::before {
            background: var(--teal);
        }

        .box:nth-child(2)::before {
            background: #2980B9;
        }

        .box:nth-child(3)::before {
            background: #8E44AD;
        }

        .box::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            border-radius: var(--radius) var(--radius) 0 0;
        }

        .box .title h2 {
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .box .amount {
            font-family: 'DM Serif Display', serif;
            font-size: 2.6rem;
            font-weight: 400;
            color: var(--navy);
            line-height: 1;
        }

    /* ── Book leave section ── */
    .Book_leave {
        background: var(--white);
        border-radius: var(--radius);
        padding: 36px 40px;
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
    }

        .Book_leave h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.5rem;
            font-weight: 400;
            color: var(--navy);
            margin-bottom: 6px;
        }

        .Book_leave > p {
            font-size: 0.82rem;
            color: var(--muted);
            margin-bottom: 28px;
            line-height: 1.5;
        }

        /* ── Form layout ── */
        .Book_leave form {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px 24px;
            align-items: end;
        }

            .Book_leave form label {
                font-size: 0.72rem;
                font-weight: 600;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--muted);
                display: block;
                margin-bottom: 4px;
                margin-top: 8px;
            }

            .Book_leave form input[type="text"],
            .Book_leave form input[type="date"],
            .Book_leave form input[type="number"] {
                width: 100%;
                height: 44px;
                padding: 0 14px;
                font-family: 'DM Sans', sans-serif;
                font-size: 0.88rem;
                border-radius: 8px;
                border: 1.5px solid var(--border);
                background: var(--white);
                color: var(--text);
                outline: none;
                transition: border-color 0.18s, box-shadow 0.18s;
            }

            .Book_leave form input:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(29, 123, 110, 0.13);
            }

            .Book_leave form input::placeholder {
                color: #A8B4BF;
            }

            /* Reason spans full width */
            .Book_leave form label[for="Reason"],
            .Book_leave form input[name="Reason"] {
                grid-column: 1 / -1;
            }

    /* Submit button spans full width */
    .submit_form {
        grid-column: 1 / -1;
        margin-top: 16px;
        height: 48px;
        background: var(--navy);
        color: var(--white);
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.18s, transform 0.12s;
    }

        .submit_form:hover {
            background: var(--teal);
            transform: translateY(-1px);
        }

        .submit_form:active {
            transform: translateY(0);
        }

    /* ── Responsive ── */
    @@media (max-width: 640px) {
        .card_container

    {
        grid-template-columns: 1fr;
    }

    .Book_leave {
        padding: 24px 20px;
    }

        .Book_leave form {
            grid-template-columns: 1fr;
        }

            .Book_leave form label[for="Reason"],
            .Book_leave form input[name="Reason"],
            .submit_form {
                grid-column: 1;
            }

    }
</style> *@
