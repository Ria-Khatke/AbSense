@{
    Layout = null;

}


<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>


<!-- Add the URl to send the data here -->

<div class="container">

    <div class="loginbox">
        <div class="title-container">
            <img src="~/img/logo.png" alt="Logo" class="logo">
            <h1 class="title">SENSORE</h1>
        </div>

        <form asp-action="login" method="post" asp-controller="Account">
            <div class="inputbox">
                <input type="text" placeholder="User ID" required id="username" name="username">
                <i class='bx bxs-user'></i>
            </div>


            <div class="inputbox">
                <input type="password" placeholder="Password" required id="password" name="password">
                <i class='bx bxs-lock-alt'></i>
            </div>

            <div class="fgt_pass_btn">
                <a asp-action="ForgotPassword" asp-controller="Account">Forgot password?</a>
            </div>

            <button type="submit" class="loginbtn">Log in</button>



            @if (ViewBag.ErrorMessage != null)
            {
                @* <div class="error-message">
                        @ViewBag.ErrorMessage
                    </div> *@
                <p style="color: red; align-content: center; margin-top: 10px">THIS IS WRONG</p>
            }
        </form>

    </div>
    <div class="right_side">
        <img src="/img/bg_img2.jpg" width="200">
    </div>

</div>


