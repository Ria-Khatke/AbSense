@{
    Layout = null;
}

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
 
<link rel="stylesheet" href="/style.css" />

<div class="container">

    <div class="login_box">
        <div class="title-container">
            <h1 class="title">Login</h1>
        </div>
        <form asp-action="login" method="post" asp-controller="Account">
            <div class="input_box">
                <input type="text" placeholder="User ID" required id="username" name="username">
                <i class='bx bxs-user'></i>
            </div>
            <div class="input_box">
                <input type="password" placeholder="Password" required id="password" name="password">
                <i class='bx bxs-lock-alt'></i>
            </div>

            <div class="fgt_pass_btn">
                <a asp-action="ForgotPassword" asp-controller="Account">Forgot password?</a>
            </div>

            <button type="submit" class="loginbtn">Log in</button>
           
        </form>
        @if (ViewBag.error == null || ViewBag.error1 == null )
        {
            <p style="color: red; align-content: center; margin-top: 10px">Incorrect username or password</p>
            <p>If you don't have your credentials, ask your workplace to create an account for you'</p>

        }
    </div>
